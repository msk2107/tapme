# Supabase 프로젝트 Settings > API 에서 값을 복사해 .env.local 파일(새로 만들기)에 붙여넣으세요.
# 이 파일(.env.local.example)은 예시일 뿐이라 값이 없어도 됩니다. 실제 값은 .env.local 에만 넣습니다.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key는 절대 클라이언트에 노출되면 안 됩니다 (NEXT_PUBLIC_ 접두사 없음).
# 서버 라우트(/api/exchanges, 공개 프로필 조회)에서만 사용됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 개발 시 매직링크 콜백에 사용. 배포 후에는 Vercel 프로젝트의 실제 도메인으로 별도 설정합니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
