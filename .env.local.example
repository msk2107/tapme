# Copy these values from your Supabase project's Settings > API Keys / Data API,
# then paste them into a new .env.local file (this example file needs no real values).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose this to the client (no NEXT_PUBLIC_ prefix).
# Used only in server routes (/api/exchanges, public profile lookup).
SUPABASE_SERVICE_ROLE_KEY=
